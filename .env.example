# Public Supabase project URL
PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe in the browser, protected by RLS)
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Looks up AACCUP staff and adds/removes people. Never in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# CTU Accounts (shared SSO). The admin reads the session from here.
ACCOUNTS_URL=https://accounts.ctu-moalboal.online

# Local development only: the .ctu-moalboal.online cookie never reaches localhost,
# so `pnpm dev` treats you as this CTU email. Ignored in production builds.
AACCUP_DEV_SSO_EMAIL=

# Public site origin, used for auth redirects and canonical URLs
PUBLIC_SITE_URL=http://localhost:5173

# CLI-only: used by `supabase db push`, never by the app.
SUPABASE_DB_PASSWORD=


# Google Drive sync (server-only). Service-account key JSON from Google Cloud, raw or base64.
# Share each visit's root Drive folder with the service account's email as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Vercel Cron sends this as a Bearer token to /api/cron/drive-sync. Any long random string.
CRON_SECRET=
